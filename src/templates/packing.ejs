<%
  var tagClasses = {
    'Alex': 'tag-alex',
    'Viv': 'tag-viv',
    'Shared': 'tag-shared'
  };
  var tagLabels = {
    'Alex': 'Alex',
    'Viv': 'Viv',
    'Shared': 'Both'
  };

  var meta = packingList.trip;
%>

<div class="header">
  <div class="header-eyebrow">April 2026 · Japan Trip</div>
  <h1>Packing List<br><em>Carry-on only</em></h1>
  <div class="header-meta">
    <span class="meta-chip">📅 Apr 10 – 30</span>
    <span class="meta-chip">🎒 Alex: 40L + 26L</span>
    <span class="meta-chip">🧳 Viv: 40L roller + 30L weekender</span>
    <span class="meta-chip">👕 <%= meta.laundry %></span>
  </div>
</div>

<div class="info-banner">
  <div class="info-strip">
    <strong>Strategy:</strong> <%= meta.strategy %>
  </div>
</div>

<div class="progress-bar-wrap">
  <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
  <div class="progress-label" id="progressLabel">0 / 0 packed</div>
  <button class="progress-reset" id="packingReset">Reset all</button>
</div>

<nav class="section-nav">
  <div class="section-nav-inner">
    <a href="#bags" class="active">Bag Plan</a>
<% packingList.sections.forEach(function(sec) { %>
    <a href="#cat-<%= sec.id %>"><%= sec.title %></a>
<% }); %>
    <a href="#tips">Tips</a>
  </div>
</nav>

<!-- Bag allocation -->
<div class="bag-map" id="bags">
  <div class="bag-map-title">How to load the bags</div>
  <div class="bag-grid">
<% Object.keys(meta.luggage).forEach(function(person) { %>
<%   meta.luggage[person].forEach(function(bag) { %>
    <div class="bag-card">
      <div class="bag-owner"><%= person %></div>
      <div class="bag-name"><%= bag.split(' (')[0] %></div>
      <div class="bag-size"><%= bag.match(/\(([^)]+)\)/) ? bag.match(/\(([^)]+)\)/)[1] : '' %></div>
    </div>
<%   }); %>
<% }); %>
  </div>
</div>

<!-- Categories -->
<% packingList.sections.forEach(function(sec) { %>
<section class="pack-section" id="cat-<%= sec.id %>">
  <div class="section-header">
    <span class="section-emoji"><%= sec.emoji %></span>
    <div class="section-title"><%= sec.title %></div>
    <div class="section-count"></div>
  </div>
<% if (sec.note) { %>
  <div class="section-note"><%= sec.note %></div>
<% } %>
  <div class="item-grid">
<% sec.items.forEach(function(item) { %>
    <div class="pack-item<%= item.optional ? ' optional-item' : '' %>" data-id="<%= item.id %>">
      <div class="pack-checkbox"><span class="check-mark">✓</span></div>
      <div class="pack-text">
        <div class="pack-name"><%= item.name %></div>
<% if (item.detail) { %>
        <div class="pack-detail"><%= item.detail %></div>
<% } %>
        <div class="pack-tags">
<% if (item.tags && item.tags.length) { %>
<%   item.tags.forEach(function(t) { %>
          <span class="tag <%= tagClasses[t] || 'tag-shared' %>"><%= tagLabels[t] || t %></span>
<%   }); %>
<% } %>
<% if (item.fancy) { %>
          <span class="tag tag-fancy">Fancy</span>
<% } %>
<% if (item.optional) { %>
          <span class="tag tag-optional">Optional</span>
<% } %>
        </div>
      </div>
    </div>
<% }); %>
  </div>
</section>
<% }); %>

<!-- Tips -->
<section class="pack-section" id="tips">
  <div class="section-header">
    <span class="section-emoji">💡</span>
    <div class="section-title">Tips</div>
  </div>
  <div class="tips-grid">
<% packingList.tips.forEach(function(tip) { %>
    <div class="tip-card">
      <div class="tip-icon"><%= tip.icon %></div>
      <div class="tip-body">
        <div class="tip-title"><%= tip.title %></div>
        <div class="tip-detail"><%= tip.detail %></div>
      </div>
    </div>
<% }); %>
  </div>
</section>
